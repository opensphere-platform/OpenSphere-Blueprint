{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensphere-platform.github.io/OpenSphere-Blueprint/specs/osr/schemas/owner-commands.schema.json",
  "title": "OS Shell 명령 계약 opensphere.owner-commands/v4 + effect",
  "description": "아카이브 owner-commands v4 필드에 effect를 더했다. 스키마는 구조만 본다. kind·mutation·effect의 정합(mutation은 apply·cancel·compensate만, mutation이면 effect는 mutation·destructive, 아니면 none·read-cost)과 정책·profile 허용 여부는 검증기가 다시 계산해 EffectPolicyViolation으로 거절한다. 제출한 effect를 믿지 않는다. assembly는 ownerBinding이 osr.definition-owner여야 한다(어셈블리 Pod가 아닌 정의 관리 고정 담당자).",
  "type": "object",
  "required": [
    "schema",
    "module",
    "ownerBinding",
    "commands"
  ],
  "properties": {
    "schema": {
      "const": "opensphere.owner-commands/v4"
    },
    "module": {
      "$ref": "#/$defs/moduleId"
    },
    "ownerBinding": {
      "enum": [
        "module-owner",
        "osr.definition-owner",
        "osr.ui-host"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "additionalProperties": false,
  "$defs": {
    "moduleId": {
      "type": "string",
      "pattern": "^(core|hiss|delivery|provider|engine|runtime|assembly|ui|product)\\.[a-z][a-z0-9-]{1,40}$"
    },
    "command": {
      "type": "object",
      "required": [
        "id",
        "description",
        "kind",
        "mutation",
        "arguments",
        "scope",
        "idempotency",
        "requiredPermissions",
        "output",
        "effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(core|hiss|delivery|provider|engine|runtime|assembly|ui|product|osr)\\.[a-z][a-z0-9-]{1,40}(\\.[a-z][a-z0-9-]*)+$"
        },
        "description": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500
        },
        "kind": {
          "enum": [
            "read",
            "discover",
            "plan",
            "apply",
            "watch",
            "verify",
            "cancel",
            "compensate"
          ]
        },
        "mutation": {
          "type": "boolean"
        },
        "arguments": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          }
        },
        "scope": {
          "enum": [
            "module",
            "installation",
            "definition"
          ]
        },
        "idempotency": {
          "enum": [
            "none",
            "request-id"
          ]
        },
        "requiredPermissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "output": {
          "type": "object",
          "required": [
            "type"
          ]
        },
        "statusCommand": {
          "type": "string",
          "pattern": "^(core|hiss|delivery|provider|engine|runtime|assembly|ui|product|osr)\\.[a-z][a-z0-9-]{1,40}(\\.[a-z][a-z0-9-]*)+$"
        },
        "review": {
          "type": "object",
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 8,
              "maxLength": 500
            }
          },
          "additionalProperties": false
        },
        "effect": {
          "enum": [
            "none",
            "read-cost",
            "mutation",
            "destructive"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mutation": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "statusCommand",
              "review"
            ],
            "properties": {
              "idempotency": {
                "const": "request-id"
              }
            }
          }
        }
      ]
    }
  }
}
