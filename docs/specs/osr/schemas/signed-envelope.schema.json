{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensphere-platform.github.io/OpenSphere-Blueprint/specs/osr/schemas/signed-envelope.schema.json",
  "title": "OSR 서명 봉투",
  "description": "서명 대상은 payload의 canonical JSON(RFC 8785) UTF-8 바이트다. 서명값은 ECDSA P-256/SHA-256, IEEE P1363(r||s 64바이트)을 base64url로 적는다.",
  "type": "object",
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "keyId",
        "value"
      ],
      "properties": {
        "alg": {
          "const": "ES256-P1363"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
